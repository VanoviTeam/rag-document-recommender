# ──────────────────────────────────────────────────────────────────────────────
# Caddyfile — Vanovi rag-document-recommender Project [Local Demo]
# ──────────────────────────────────────────────────────────────────────────────
# This file is a simplified version for local demo purposes.
# Since development branches are for local testing, we have
# removed the complex Authentik (Identity Provider) layer that
# requires actual routable domain names.
#
# It simply maps HTTP traffic from port 80 to n8n internally.
# ──────────────────────────────────────────────────────────────────────────────

:80 {
    # Redirect traffic from port 80 directly to n8n port 5678
    reverse_proxy n8n:5678
}
