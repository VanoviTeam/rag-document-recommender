# ── n8n Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=n8n_local_user
POSTGRES_PASSWORD=n8n_local_password_secure!
POSTGRES_DB=n8n_local

# ── n8n Configuration ─────────────────────────────────────────────────────────
# You can use these defaults for the demo, but they can be changed as you wish.
N8N_ENCRYPTION_KEY=local_demo_encryption_key_12345
N8N_USER_MANAGEMENT_JWT_SECRET=local_demo_jwt_secret_67890
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_NUM_PARALLEL=4

# ── Email (SMTP) – (Optional) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=your_email@gmail.com
