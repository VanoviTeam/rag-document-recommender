# ── n8n Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=n8n_local_user
POSTGRES_PASSWORD=n8n_local_password_secure!
POSTGRES_DB=n8n_local

# ── n8n Configuration ─────────────────────────────────────────────────────────
# Puedes usar estas por defecto para la demo, pero en producción deberían cambiarse
N8N_ENCRYPTION_KEY=local_demo_encryption_key_12345
N8N_USER_MANAGEMENT_JWT_SECRET=local_demo_jwt_secret_67890
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_NUM_PARALLEL=4

# ── Email (SMTP) – Book Recommendation Bot (Opcional) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_de_google
SMTP_FROM=tu_correo@gmail.com
